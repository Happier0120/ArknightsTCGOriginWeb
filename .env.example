# 本地生产模式可选；CloudBase Run 容器默认使用 8080。
PORT=4174

# 房间快照位置。CloudBase Run 免费容器改用 /tmp/rooms.json。
ATCG_ROOM_STATE_PATH=server/data/rooms.json

# 上一代有效快照；主文件损坏时自动恢复并修复主文件。
ATCG_ROOM_BACKUP_PATH=server/data/rooms.backup.json

# 无活动房间保留时间，默认 24 小时。
ATCG_ROOM_MAX_AGE_MS=86400000

# 单条 Socket 消息最大 128 KiB。
ATCG_SOCKET_MAX_PAYLOAD_BYTES=131072

# 每个 60 秒窗口的请求上限：入房按来源地址，其余按 Socket 连接。
ATCG_ENTRY_RATE_LIMIT=12
ATCG_CONTROL_RATE_LIMIT=120
ATCG_COMMAND_RATE_LIMIT=240

# 默认前后端同源，无需设置。拆分域名时使用逗号分隔的完整 Origin。
# ATCG_ALLOWED_ORIGINS=https://example.com,https://www.example.com
